{
  "name": "CustomDirecte",
  "description": "Ajoute de nouvelles options sur EcoleDirecte ! Afficher votre moyenne générale, personnaliser l'interface...",
  "author": "Bastian NOEL",
  "version": "30.0.1",
  "version_name": "3.0.1",
  "manifest_version": 3,
  "devtools_page": "/pages/popup/interface.html",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "*://*.ecoledirecte.com/*"
  ],
  "action": {
    "default_title": "CustomDirecte",
    "default_icon": {
      "16": "/icons/EcoleDirecte/default/icon16.png",
      "32": "/icons/EcoleDirecte/default/icon32.png",
      "48": "/icons/EcoleDirecte/default/icon48.png",
      "128": "/icons/EcoleDirecte/default/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "/pages/bac/sidebar.html"
  },
  "icons": {
    "16": "/icons/EcoleDirecte/default/icon16.png",
    "32": "/icons/EcoleDirecte/default/icon32.png",
    "48": "/icons/EcoleDirecte/default/icon48.png",
    "128": "/icons/EcoleDirecte/default/icon128.png"
  },
  "content_scripts": [{
    "matches": ["*://*.ecoledirecte.com/*"],
    "run_at": "document_start",
    "all_frames": true,
    "js": ["/scripts/browser.js", "/scripts/log.js", "/core/settings/settings.js", "/core/settings/parameters.js", "/utils/math.js", "/utils/notesStorage.js", "/scripts/main.js", "/modules/customizationModule.js", "/modules/sidebarModule.js", "/modules/noteTableModule.js"],
    "css": ["/styles/notesTable.css", "/styles/sidebar.css", "/styles/customizationButton.css"]
  }],
  "web_accessible_resources": [{
    "resources": ["/styles/customizations.css", "/pages/popup/interface.html", "/pages/popup/interfaces/classic/templates.html", "/pages/popup/interfaces/legacy/templates.html", "/pages/popup/interfaces/legacy/interface.css", "/pages/bac/sidebar.html", "/scripts/darkreader.js", "/scripts/tippy.js", "/styles/default.css", "/icons/EcoleDirecte/default/icon.svg", "/icons/EcoleDirecte/default.ico", "/icons/EcoleDirecte/magenta.ico"],
    "matches": ["*://*.ecoledirecte.com/*"]
  }],
  "background": {
    "service_worker": "/scripts/background.js"
  }
}
